#!/usr/bin/env bash
# Sample pre-commit hook for adrian.
#
# Install with:
#   ln -s ../../scripts/pre-commit .git/hooks/pre-commit
#
# Requires `adrian` (or the compatibility `adr-lint`) on PATH and the
# Claude Code CLI authenticated.

set -e

if command -v adrian >/dev/null 2>&1; then
  exec adrian check
elif command -v adr-lint >/dev/null 2>&1; then
  exec adr-lint
fi
echo "adrian/adr-lint not on PATH; skipping ADR check" >&2
